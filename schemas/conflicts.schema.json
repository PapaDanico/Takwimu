{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/conflicts.schema.json",
  "title": "Source conflict register (data/conflicts.json)",
  "type": "object",
  "required": [
    "meta",
    "conflicts"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "rule",
        "reviewed",
        "updated",
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "reviewed": {
          "type": "string"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "schema_version": {
          "type": "string"
        }
      }
    },
    "conflicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "measure",
          "unit",
          "values",
          "definitions",
          "hypothesis",
          "status",
          "effect",
          "verification_state",
          "supersedes",
          "page_image_checked"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "measure": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "label",
                "value",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "A number, or a short text for cases about a label, citation or licence (no arithmetic is done on text values)"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          },
          "definitions": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "effect": {
            "type": "string"
          },
          "verification_state": {
            "type": "string",
            "enum": [
              "resolved_by_source",
              "unresolved_no_reviewer",
              "reviewed"
            ]
          },
          "reviewer": {
            "type": "string"
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_image_checked": {
            "type": "boolean"
          },
          "reread": {
            "type": "object",
            "required": [
              "on",
              "method_a",
              "method_b",
              "readings",
              "check",
              "outcome",
              "page_image_checked"
            ],
            "additionalProperties": false,
            "properties": {
              "on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "method_a": {
                "type": "string"
              },
              "method_b": {
                "type": "string"
              },
              "readings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "where",
                    "method_a",
                    "method_b"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "where": {
                      "type": "string"
                    },
                    "method_a": {
                      "type": "string"
                    },
                    "method_b": {
                      "type": "string"
                    }
                  }
                }
              },
              "check": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              },
              "page_image_checked": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            }
          },
          "register": {
            "type": "string",
            "enum": [
              "our_correction",
              "source_error",
              "no_change"
            ],
            "description": "For a resolved case: our_correction (Takwimu changed a value, label or citation; listed on /corrections/), source_error (the source document is in error; listed on /corrections/ as a source error, not our correction), no_change (rounding or a reading never used)."
          },
          "correction": {
            "type": "object",
            "required": [
              "original",
              "corrected",
              "reason",
              "evidence",
              "date",
              "affected_pages"
            ],
            "additionalProperties": false,
            "properties": {
              "original": {
                "type": "string"
              },
              "corrected": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "affected_pages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "records": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z-]+\\|.+$"
                },
                "description": "dataset|record id of each value the correction changed"
              }
            }
          },
          "ledger_case": {
            "type": "string",
            "pattern": "^D-[LK]\\d{3}-[LK]\\d{3}$"
          },
          "observations": {
            "type": "array",
            "description": "Other counties (data/counties/<slug>/conflicts.json): the ledger, population or audit records whose values the case compares, as dataset|id; scripts/test-county-reconciliation.js checks each value against them.",
            "minItems": 2,
            "items": { "type": "string", "pattern": "^[a-z-]+\\|.+$" }
          },
          "ledger_cases": {
            "type": "array",
            "description": "Fiscal-ledger discrepancy cases (data/siaya-fiscal-ledger.json) that compare values of this case; lib/conflict-links.js, checked by scripts/test-reconciliation.js",
            "items": { "type": "string", "pattern": "^D-[LK]\\d{3}-[LK]\\d{3}$" },
            "minItems": 1
          }
        }
      }
    }
  }
}
