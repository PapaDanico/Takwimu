{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-budget-departments.schema.json",
  "title": "Siaya budgets and spending by department (data/siaya-budget-departments.json)",
  "description": "County Treasury programme-based budgets (PBB) and Budget Review and Outlook Papers (CBROP), FY 2014/15 to FY 2025/26. Rules beyond this schema (unique ids, sums, crosswalk coverage, sources in the library with the same hash) are checked by scripts/test-budget-departments.js.",
  "type": "object",
  "required": ["meta", "departments", "sources", "crosswalk", "unmatched", "observations", "sum_checks", "row_checks"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "county", "county_code", "retrieved", "schema_version", "rule", "read_method", "confidence_scale", "review", "gaps"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "county": { "type": "string", "enum": ["Siaya"] },
        "county_code": { "type": "integer", "enum": [41] },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "schema_version": { "type": "string" },
        "rule": { "type": "string" },
        "read_method": { "type": "string" },
        "confidence_scale": { "type": "string" },
        "review": { "type": "string" },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fy", "what", "reason"],
            "additionalProperties": false,
            "properties": { "fy": { "$ref": "#/$defs/fy" }, "what": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "departments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["code", "label"], "additionalProperties": false, "properties": { "code": { "$ref": "#/$defs/code" }, "label": { "type": "string" } } }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "kind", "sha256", "url"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["PBB", "CBROP"] },
          "reviews_fy": { "$ref": "#/$defs/fy" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "crosswalk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "printed_name", "fys", "source_ids", "comparability"],
        "additionalProperties": false,
        "properties": {
          "code": { "$ref": "#/$defs/code" },
          "printed_name": { "type": "string" },
          "fys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fy" } },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "comparability": { "type": "string" }
        }
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fy", "source_id", "table", "printed_name", "reason", "values_as_printed"],
        "additionalProperties": false,
        "properties": {
          "fy": { "$ref": "#/$defs/fy" }, "source_id": { "type": "string" }, "table": { "type": "string" }, "printed_name": { "type": "string" }, "reason": { "type": "string" },
          "values_as_printed": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fy", "dept_code", "printed_name", "measure", "class", "budget_version", "includes_balance_bf", "value", "unit", "original_text", "source_id", "document_kind", "table", "pdf_page", "printed_page", "read_method", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^BD-\\d{4}-(PBB|CBROP)-[A-Z-]+-(budget|actual)-(tot|rec|dev|pe|om)(-(orig|supp|fina))?(-(bf|nobf))?$" },
          "fy": { "$ref": "#/$defs/fy" },
          "dept_code": { "$ref": "#/$defs/code" },
          "printed_name": { "type": "string" },
          "measure": { "type": "string", "enum": ["budget", "actual"] },
          "class": { "type": "string", "enum": ["total", "recurrent", "development", "compensation", "operations"] },
          "budget_version": { "type": ["string", "null"], "enum": ["original", "supplementary", "final", null] },
          "includes_balance_bf": { "type": ["boolean", "null"] },
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string", "enum": ["KSh"] },
          "original_text": { "type": "string" },
          "source_id": { "type": "string" },
          "document_kind": { "type": "string", "enum": ["PBB", "CBROP"] },
          "table": { "type": "string" },
          "pdf_page": { "type": "integer", "minimum": 1 },
          "printed_page": { "type": ["integer", "null"] },
          "read_method": { "type": "string", "enum": ["text"] },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "note": { "type": "string" }
        }
      }
    },
    "sum_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["total_id", "part_ids", "printed_total", "sum_of_parts", "difference", "status"],
        "additionalProperties": false,
        "properties": {
          "total_id": { "type": "string" }, "part_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "printed_total": { "type": "number" }, "sum_of_parts": { "type": "number" }, "difference": { "type": "number" },
          "status": { "type": "string", "enum": ["adds", "within rounding (KSh 5 or less)", "does not add"] }
        }
      }
    },
    "row_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["total_id", "recurrent_id", "development_id", "difference", "status"],
        "additionalProperties": false,
        "properties": {
          "total_id": { "type": "string" }, "recurrent_id": { "type": "string" }, "development_id": { "type": "string" }, "difference": { "type": "number" },
          "status": { "type": "string", "enum": ["adds", "within rounding (KSh 5 or less)", "does not add"] }
        }
      }
    }
  },
  "$defs": {
    "fy": { "type": "string", "pattern": "^\\d{4}/\\d{2}$" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z-]+$" }
  }
}
