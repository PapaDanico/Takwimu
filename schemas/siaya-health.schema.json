{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-health.schema.json",
  "title": "Siaya health indicators by source, vintage and geography (data/siaya-health.json)",
  "type": "object",
  "required": ["meta", "sources", "observations", "conflicts", "gaps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "county", "county_code", "retrieved", "schema_version", "rule", "confidence_scale", "definitions"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "county": { "enum": ["Siaya"] },
        "county_code": { "type": "integer" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "schema_version": { "type": "string" },
        "rule": { "type": "string" },
        "confidence_scale": { "type": "object", "additionalProperties": { "type": "string" } },
        "definitions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "library_id", "title", "publisher", "publication_date", "reference_period", "url", "file_type", "sha256", "bytes", "pdf_pages", "page_rule", "kind", "licence", "access_status", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "library_id": { "type": "string" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "publication_date": { "type": "string" },
          "reference_period": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "file_type": { "enum": ["PDF", "HTML"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": ["integer", "null"], "minimum": 1 },
          "pdf_pages": { "type": ["integer", "null"], "minimum": 1 },
          "page_rule": { "type": "string" },
          "kind": { "type": "string" },
          "licence": { "type": "string" },
          "access_status": { "enum": ["downloaded", "inaccessible"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "measure", "label", "value", "unit", "period", "vintage", "age_group", "sex", "population", "geography", "geography_detail", "method", "source_id", "table", "pdf_page", "printed_page", "page_note", "confidence", "status", "sentinel_site", "original_source", "history_ref", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "source_error": { "type": "object", "description": "An error in the source document itself (impossible date, figures that do not agree). The value stays as published.", "required": ["quote", "page", "issue"], "additionalProperties": false, "properties": { "quote": { "type": "string", "minLength": 3 }, "page": { "type": "integer", "minimum": 1 }, "printed_page": { "type": ["integer", "null"] }, "issue": { "type": "string", "minLength": 10 } } },
          "measure": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "period": { "type": "string" },
          "vintage": { "type": "string" },
          "age_group": { "type": "string" },
          "sex": { "enum": ["both", "male", "female"] },
          "population": { "type": "string" },
          "geography": { "enum": ["county", "sub-county", "sentinel-site"] },
          "geography_detail": { "type": "string" },
          "method": { "type": "string" },
          "source_id": { "type": "string" },
          "table": { "type": "string" },
          "pdf_page": { "type": ["integer", "null"], "minimum": 1 },
          "printed_page": { "type": ["integer", "null"], "minimum": 1 },
          "page_note": { "type": ["string", "null"] },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "status": { "enum": ["primary", "secondary report", "sentinel-site"] },
          "sentinel_site": { "type": "boolean" },
          "original_source": { "type": ["string", "null"] },
          "history_ref": { "type": ["string", "null"], "pattern": "^(indicator:[a-z-]+:(2014|2022)|hiv:\\d{4})$" },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measure", "observation_ids", "note"],
        "additionalProperties": false,
        "properties": {
          "measure": { "type": "string" },
          "observation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measure", "reason", "next_step"],
        "additionalProperties": false,
        "properties": {
          "measure": { "type": "string" },
          "reason": { "type": "string" },
          "next_step": { "type": "string" }
        }
      }
    }
  }
}
