{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-education.schema.json",
  "title": "Siaya education and human development by source (data/siaya-education.json)",
  "type": "object",
  "required": ["meta", "sources", "observations", "sum_checks", "conflicts", "gaps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "county", "county_code", "retrieved", "schema_version", "rule", "definitions"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "county": { "enum": ["Siaya"] },
        "county_code": { "type": "integer" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "schema_version": { "type": "string" },
        "rule": { "type": "string" },
        "definitions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "library_id", "publisher", "title", "publication_date", "reference_period", "url", "sha256", "bytes", "pdf_pages", "printed_page_offset", "licence", "note"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "library_id": { "type": ["string", "null"] },
          "publisher": { "type": "string" },
          "title": { "type": "string" },
          "publication_date": { "type": "string" },
          "reference_period": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "pdf_pages": { "type": "integer", "minimum": 1 },
          "printed_page_offset": { "type": ["integer", "null"] },
          "licence": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_id", "indicator", "function", "level", "sex", "sector", "period", "value", "unit", "value_type", "table", "pdf_page", "printed_page", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "source_id": { "type": "string" },
          "indicator": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "function": { "enum": ["devolved", "national"] },
          "level": { "enum": ["pre-primary", "primary", "secondary", "vtc", "tvet", "bursary", "finance", "attainment", "population", "labour"] },
          "sex": { "enum": ["total", "male", "female"] },
          "sector": { "type": "string" },
          "period": { "type": "string", "minLength": 4 },
          "value": { "type": ["number", "null"] },
          "printed_value": { "type": "string" },
          "unit": { "type": "string" },
          "value_type": { "enum": ["actual", "provisional", "baseline", "plan_target", "approved_estimate", "projection", "survey_estimate"] },
          "table": { "type": "string", "minLength": 3 },
          "pdf_page": { "type": "integer", "minimum": 1 },
          "printed_page": { "type": ["integer", "null"] },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "note": { "type": "string" },
          "check": {
            "type": "object",
            "required": ["kind", "numerator", "denominator", "scale", "decimals"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["ratio"] },
              "numerator": { "type": "string" },
              "denominator": { "type": "string" },
              "scale": { "type": "number" },
              "decimals": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "sum_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "total", "parts", "tolerance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "total": { "type": ["string", "null"] },
          "parts": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "tolerance": { "type": "number", "minimum": 0 }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "observations", "description", "handling"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^edu-c\\d{2}$" },
          "type": { "enum": ["published_ratio_inconsistent", "denominator_mismatch", "sex_columns_swapped", "same_metric_different_values", "population_used_as_enrolment", "implausible_value"] },
          "observations": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "description": { "type": "string" },
          "handling": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["indicator", "function", "reason", "checked"],
        "additionalProperties": false,
        "properties": {
          "indicator": { "type": "string" },
          "function": { "enum": ["devolved", "national"] },
          "reason": { "type": "string" },
          "checked": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
