{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimukenya.com/schemas/siaya-wards-geo.schema.json",
  "title": "Siaya county assembly ward boundaries (data/siaya-wards-geo.json)",
  "type": "object",
  "required": ["type", "meta", "features"],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lonlat": { "type": "array", "minItems": 2, "items": { "type": "number" } }
  },
  "properties": {
    "type": { "enum": ["FeatureCollection"] },
    "meta": {
      "type": "object",
      "required": ["title", "publisher", "distributor", "dataset", "dataset_url", "resource_url", "resource_sha256", "licence", "licence_text", "licence_url", "attribution", "source_caveat", "vintage", "retrieved", "crs", "simplification", "county_bbox", "county_bbox_source", "crosscheck"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "distributor": { "type": "string" },
        "dataset": { "type": "string" },
        "dataset_url": { "type": "string", "pattern": "^https://" },
        "resource_url": { "type": "string", "pattern": "^https://" },
        "resource_sha256": { "$ref": "#/$defs/sha256" },
        "licence": { "type": "string" },
        "licence_text": { "type": "string" },
        "licence_url": { "type": "string", "pattern": "^https://" },
        "attribution": { "type": "string", "pattern": "^Ward boundaries: .+ via HDX, CC BY, \\d{4}$" },
        "source_caveat": { "type": "string" },
        "vintage": { "type": "string" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "crs": { "type": "string" },
        "simplification": { "type": "string" },
        "county_bbox": { "type": "array", "minItems": 4, "items": { "type": "number" } },
        "county_bbox_source": { "type": "string" },
        "crosscheck": {
          "type": "object",
          "required": ["dataset", "dataset_url", "publisher", "licence", "resource_sha256", "vintage", "caveat", "method"],
          "additionalProperties": false,
          "properties": {
            "dataset": { "type": "string" },
            "dataset_url": { "type": "string", "pattern": "^https://" },
            "publisher": { "type": "string" },
            "licence": { "type": "string" },
            "resource_sha256": { "$ref": "#/$defs/sha256" },
            "vintage": { "type": "string" },
            "caveat": { "type": "string" },
            "method": { "type": "string" }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["Feature"] },
          "properties": {
            "type": "object",
            "required": ["ward_id", "ward_code", "ward_name", "constituency_id", "constituency_name", "constituency_code", "source_name", "source_subcounty", "source_uid", "label", "crosscheck_fao"],
            "additionalProperties": false,
            "properties": {
              "ward_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "ward_code": { "type": "string", "pattern": "^\\d{4}$" },
              "ward_name": { "type": "string" },
              "constituency_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "constituency_name": { "type": "string" },
              "constituency_code": { "type": "string", "pattern": "^\\d{3}$" },
              "source_name": { "type": "string" },
              "source_subcounty": { "type": "string" },
              "source_uid": { "type": "string" },
              "label": { "$ref": "#/$defs/lonlat" },
              "crosscheck_fao": {
                "type": ["object", "null"],
                "required": ["name", "code", "iou"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "code": { "type": ["string", "null"] },
                  "iou": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["MultiPolygon"] },
              "coordinates": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/lonlat" } } } }
            }
          }
        }
      }
    }
  }
}
