{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/derived.schema.json",
  "title": "Derived measures (data/derived.json)",
  "type": "object",
  "required": ["meta", "generated", "measures", "side_by_side_conflicts"],
  "properties": {
    "meta": { "type": "object", "required": ["title", "retrieved", "schema_version", "rule"] },
    "measures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["derived", "name", "unit", "formula", "inputs", "values"],
        "properties": { "derived": { "type": "boolean", "enum": [true] }, "formula": { "type": "string", "pattern": "." }, "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "values": { "type": "object", "additionalProperties": { "type": ["number", "null"] } } }
      }
    }
  }
}
