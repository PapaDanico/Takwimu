{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Siaya NGO, CSO and donor programme atlas",
 "type": "object",
 "required": ["meta", "sources", "programmes", "screened_out", "gaps", "summary"],
 "additionalProperties": false,
 "$defs": {
  "sourceRef": {
   "type": "object",
   "required": ["source_id", "page", "locator"],
   "additionalProperties": false,
   "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "page": {"type": ["string", "integer"]},
    "locator": {"type": "string", "minLength": 1},
    "quote": {"type": "string"},
    "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
   }
  }
 },
 "properties": {
  "meta": {
   "type": "object",
   "required": ["title", "compiled", "window", "rules", "not_verified"],
   "additionalProperties": false,
   "properties": {
    "title": {"type": "string"},
    "compiled": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "window": {"type": "string"},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "not_verified": {"type": "string"}
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "title", "publisher", "publication_date", "reference_period", "url", "library_dir", "sha256", "file_type", "tier", "page_rule", "retrieved"],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "minLength": 1},
     "title": {"type": "string"},
     "publisher": {"type": "string"},
     "publication_date": {"type": "string"},
     "reference_period": {"type": "string"},
     "url": {"type": "string", "pattern": "^https://"},
     "library_dir": {"type": "string"},
     "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "file_type": {"type": "string"},
     "tier": {"type": "string", "enum": ["A", "B", "C", "D"]},
     "page_rule": {"type": "string"},
     "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
     "note": {"type": "string"}
    }
   }
  },
  "programmes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "title", "implementing_organisation", "implementing_organisation_type", "funder", "funder_basis", "sector", "geography", "period", "status", "amounts", "beneficiaries", "outputs_outcomes_as_stated", "evidence_type", "evaluation", "parent_programme", "sources", "tier", "notes"],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^SIA-G-\\d{3}$"},
     "title": {"type": "string", "minLength": 1},
     "implementing_organisation": {"type": "string", "minLength": 1},
     "implementing_organisation_type": {"type": ["string", "null"], "enum": ["county_government", "national_government", "ngo_cso", "community_based_organisation", "un_agency", "research_institution", "private_company", "humanitarian_agency", null]},
     "funder": {"type": "string", "minLength": 1},
     "funder_basis": {"type": "string", "minLength": 1},
     "sector": {"type": "string", "enum": ["health", "water_sanitation", "agriculture_food", "fisheries_blue_economy", "climate_environment", "governance_accountability", "devolution_public_finance", "education", "youth_livelihoods", "energy", "urban_development", "social_protection", "research_surveillance", "gender_rights", "financial_inclusion", "humanitarian"]},
     "geography": {
      "type": "object",
      "required": ["class", "areas_as_printed", "wards_as_printed", "other_counties_as_printed", "note", "ward_resolution"],
      "additionalProperties": false,
      "properties": {
       "class": {"type": "string", "enum": ["siaya_specific", "siaya_wards_listed", "multi_county_including_siaya", "national"]},
       "areas_as_printed": {"type": "array", "items": {"type": "string"}},
       "wards_as_printed": {"type": "array", "items": {"type": "string"}},
       "other_counties_as_printed": {"type": "array", "items": {"type": "string"}},
       "note": {"type": ["string", "null"]},
       "ward_resolution": {
        "type": "array",
        "items": {
         "type": "object",
         "required": ["name_as_printed", "ward_id", "flag"],
         "additionalProperties": false,
         "properties": {
          "name_as_printed": {"type": "string"},
          "ward_id": {"type": ["string", "null"]},
          "flag": {"type": ["string", "null"]}
         }
        }
       }
      }
     },
     "period": {
      "type": "object",
      "required": ["start", "end", "as_printed"],
      "additionalProperties": false,
      "properties": {
       "start": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"},
       "end": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"},
       "as_printed": {"type": "string"}
      }
     },
     "status": {"type": ["string", "null"]},
     "amounts": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["kind", "value", "currency", "period", "scope", "pooled", "source"],
       "additionalProperties": false,
       "properties": {
        "kind": {"type": "string", "enum": ["budget", "commitment", "allocation", "receipt", "disbursement", "expenditure"]},
        "value": {"type": ["number", "null"], "minimum": -1000000000000},
        "currency": {"type": "string", "enum": ["KES", "USD", "EUR", "GBP", "CAD", "DKK", "XDR", "not stated"]},
        "period": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "enum": ["siaya_specific", "pooled_total"]},
        "pooled": {"type": "boolean"},
        "source": {"$ref": "#/$defs/sourceRef"},
        "value_as_printed": {"type": "string"},
        "note": {"type": "string"}
       }
      }
     },
     "beneficiaries": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["value", "unit", "as_printed", "scope", "pooled", "source"],
       "additionalProperties": false,
       "properties": {
        "value": {"type": "integer", "minimum": 0},
        "unit": {"type": "string"},
        "as_printed": {"type": "string"},
        "scope": {"type": "string", "enum": ["siaya_specific", "pooled_total"]},
        "pooled": {"type": "boolean"},
        "source": {"$ref": "#/$defs/sourceRef"}
       }
      }
     },
     "outputs_outcomes_as_stated": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["kind", "text", "attributable_to_siaya", "source"],
       "additionalProperties": false,
       "properties": {
        "kind": {"type": "string", "enum": ["objective", "output", "outcome"]},
        "text": {"type": "string", "minLength": 1},
        "attributable_to_siaya": {"type": "boolean"},
        "source": {"$ref": "#/$defs/sourceRef"}
       }
      }
     },
     "evidence_type": {"type": "string", "enum": ["planned", "self_reported", "independently_evaluated"]},
     "evaluation": {
      "type": ["object", "null"],
      "required": ["by", "date", "rating_as_published", "scope", "siaya_disaggregated", "source"],
      "additionalProperties": false,
      "properties": {
       "by": {"type": "string"},
       "date": {"type": ["string", "null"]},
       "rating_as_published": {"type": "string"},
       "scope": {"type": "string"},
       "siaya_disaggregated": {"type": "boolean"},
       "source": {"$ref": "#/$defs/sourceRef"}
      }
     },
     "parent_programme": {"type": ["string", "null"], "pattern": "^SIA-G-\\d{3}$"},
     "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
     "tier": {"type": "string", "enum": ["A", "B", "C", "D"]},
     "notes": {"type": ["string", "null"]}
    }
   }
  },
  "screened_out": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["source_id", "title", "sha256", "pages_checked", "finding"],
    "additionalProperties": false,
    "properties": {
     "source_id": {"type": "string"},
     "title": {"type": "string"},
     "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
     "pages_checked": {"type": "string"},
     "finding": {"type": "string"}
    }
   }
  },
  "gaps": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["topic", "status", "detail"],
    "additionalProperties": false,
    "properties": {
     "topic": {"type": "string"},
     "status": {"type": "string"},
     "detail": {"type": "string"}
    }
   }
  },
  "summary": {
   "type": "object",
   "required": ["record_count", "by_geography_class", "by_evidence_type", "siaya_development_partner_grants_kes", "reconciliation", "totals_rule"],
   "additionalProperties": false,
   "properties": {
    "record_count": {"type": "integer"},
    "by_geography_class": {"type": "object", "additionalProperties": {"type": "integer"}},
    "by_evidence_type": {"type": "object", "additionalProperties": {"type": "integer"}},
    "siaya_development_partner_grants_kes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["period", "kind", "currency", "total", "record_ids"],
      "additionalProperties": false,
      "properties": {
       "period": {"type": "string"},
       "kind": {"type": "string", "enum": ["allocation", "receipt"]},
       "currency": {"type": "string", "enum": ["KES"]},
       "total": {"type": "number"},
       "record_ids": {"type": "array", "items": {"type": "string", "pattern": "^SIA-G-\\d{3}$"}}
      }
     }
    },
    "reconciliation": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["period", "kind", "printed_total", "printed_total_label", "source", "excluded_lines", "excluded_reason"],
      "additionalProperties": false,
      "properties": {
       "period": {"type": "string"},
       "kind": {"type": "string", "enum": ["allocation", "receipt"]},
       "printed_total": {"type": "number"},
       "printed_total_label": {"type": "string"},
       "source": {"$ref": "#/$defs/sourceRef"},
       "excluded_lines": {"type": "array", "items": {"type": "object", "required": ["line", "value"], "additionalProperties": false, "properties": {"line": {"type": "string"}, "value": {"type": "number"}}}},
       "excluded_reason": {"type": "string"}
      }
     }
    },
    "totals_rule": {"type": "string"}
   }
  }
 }
}
