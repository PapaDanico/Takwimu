{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "County budget, exchequer, expenditure and absorption by department (Controller of Budget department tables)",
  "type": "object",
  "required": ["meta", "columns", "headers_by_year", "records", "checks", "comparisons", "gaps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "county", "county_code", "unit", "rule", "source_ids", "extracted", "status", "held"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "county": { "type": "string" },
        "county_code": { "type": "integer", "minimum": 1, "maximum": 47 },
        "unit": { "type": "string" },
        "rule": { "type": "string" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "extracted": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "type": "string", "pattern": "^Provisional" },
        "held": { "type": "boolean" }
      }
    },
    "columns": { "type": "object", "additionalProperties": { "type": "string" } },
    "headers_by_year": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["budget", "exchequer"], "additionalProperties": false,
        "properties": { "budget": { "type": "string" }, "exchequer": { "type": "string" } }
      }
    },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "required": ["fy", "check", "computed", "printed", "agrees"], "additionalProperties": false,
        "properties": { "fy": { "$ref": "#/$defs/fy" }, "check": { "type": "string" }, "computed": { "type": "number" }, "printed": { "type": "number" }, "agrees": { "type": "boolean" } }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object", "required": ["fy", "measure", "department_table_total", "counties_cob_value", "counties_cob_field", "agrees"], "additionalProperties": false,
        "properties": {
          "fy": { "$ref": "#/$defs/fy" }, "measure": { "type": "string" },
          "department_table_total": { "type": "number" }, "counties_cob_value": { "type": ["number", "null"] },
          "counties_cob_field": { "type": "string" }, "agrees": { "type": "boolean" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object", "required": ["item", "status", "reason"], "additionalProperties": false,
        "properties": { "item": { "type": "string" }, "status": { "enum": ["not yet read", "not in source", "not held"] }, "reason": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "fy": { "type": "string", "pattern": "^\\d{4}/\\d{2}$" },
    "cell": {
      "type": "object", "required": ["value", "status"], "additionalProperties": false,
      "properties": {
        "value": { "type": ["number", "null"] },
        "status": { "enum": ["printed", "dash", "blank", "doubtful"] },
        "note": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "required": ["id", "fy", "department", "is_total", "source_id", "table", "pdf_page", "printed_page", "read_method", "confidence", "cells"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+-dept-\\d{4}-\\d{2}-[a-z0-9-]+$" },
        "fy": { "$ref": "#/$defs/fy" },
        "department": { "type": "string" },
        "is_total": { "type": "boolean" },
        "source_id": { "type": "string" },
        "table": { "type": "string" },
        "pdf_page": { "type": "integer", "minimum": 1 },
        "printed_page": { "type": ["integer", "null"], "minimum": 1 },
        "read_method": { "enum": ["image", "text", "ocr"] },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 3 },
        "cells": {
          "type": "object",
          "required": ["budget_rec", "budget_dev", "exchequer_rec", "exchequer_dev", "expenditure_rec", "expenditure_dev", "exp_to_exchequer_rec_pct", "exp_to_exchequer_dev_pct", "absorption_rec_pct", "absorption_dev_pct"],
          "additionalProperties": false,
          "properties": {
            "budget_rec": { "$ref": "#/$defs/cell" }, "budget_dev": { "$ref": "#/$defs/cell" },
            "exchequer_rec": { "$ref": "#/$defs/cell" }, "exchequer_dev": { "$ref": "#/$defs/cell" },
            "expenditure_rec": { "$ref": "#/$defs/cell" }, "expenditure_dev": { "$ref": "#/$defs/cell" },
            "exp_to_exchequer_rec_pct": { "$ref": "#/$defs/cell" }, "exp_to_exchequer_dev_pct": { "$ref": "#/$defs/cell" },
            "absorption_rec_pct": { "$ref": "#/$defs/cell" }, "absorption_dev_pct": { "$ref": "#/$defs/cell" }
          }
        }
      }
    }
  }
}
