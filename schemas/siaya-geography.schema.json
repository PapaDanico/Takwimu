{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-geography.schema.json",
  "title": "Siaya geographic registry (data/siaya-geography.json)",
  "type": "object",
  "required": ["meta", "sources", "county", "constituencies", "wards", "sub_county_systems", "spatial_layers"],
  "additionalProperties": false,
  "$defs": {
    "alias": {
      "type": "object",
      "required": ["name", "seen_in"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "seen_in": { "type": "string" } }
    },
    "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "compiled", "official_name_rule", "boundary_vintage", "confidence", "note"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "compiled": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "official_name_rule": { "type": "string" },
        "boundary_vintage": { "type": "string" },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "note": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "publisher", "published", "url", "retrieved", "used_for"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "published": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "retrieved": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "pages": { "type": "string" },
          "used_for": { "type": "string" },
          "limitation": { "type": "string" }
        }
      }
    },
    "county": {
      "type": "object",
      "required": ["id", "name", "iebc_county_code", "aliases", "constituency_ids"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "iebc_county_code": { "type": "string", "pattern": "^\\d{3}$" },
        "constitution_first_schedule_number": { "type": "integer", "minimum": 1, "maximum": 47 },
        "aliases": { "$ref": "#/$defs/aliases" },
        "constituency_ids": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "constituencies": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "name", "iebc_constituency_code", "parent", "aliases", "ward_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "iebc_constituency_code": { "type": "string", "pattern": "^\\d{3}$" },
          "parent": { "$ref": "#/$defs/id" },
          "aliases": { "$ref": "#/$defs/aliases" },
          "ward_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "wards": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "name", "iebc_ward_code", "iebc_constituency_code", "parent", "source_names", "aliases"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "iebc_ward_code": { "type": "string", "pattern": "^\\d{4}$" },
          "iebc_constituency_code": { "type": "string", "pattern": "^\\d{3}$" },
          "parent": { "$ref": "#/$defs/id" },
          "source_names": {
            "type": "object",
            "required": ["IEBC-2017-RESULTS", "IEBC-GN-13904-2025", "CIDP-2023-27"],
            "additionalProperties": { "type": ["string", "null"] }
          },
          "aliases": { "$ref": "#/$defs/aliases" }
        }
      }
    },
    "sub_county_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["system", "label", "source", "units", "equivalence"],
        "additionalProperties": false,
        "properties": {
          "system": { "type": "string", "enum": ["county-government", "knbs-census-2019"] },
          "label": { "type": "string" },
          "source": { "type": "string" },
          "equivalence": { "type": "string" },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "constituency_id"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "constituency_id": { "$ref": "#/$defs/id" },
                "wards": { "type": "integer", "minimum": 1 },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "spatial_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "level", "source", "note"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": ["string", "null"] },
          "level": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "upstream": { "type": "string" },
          "boundary_year_represented": { "type": "string" },
          "licence": { "type": "string" },
          "build_date": { "type": "string" },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
