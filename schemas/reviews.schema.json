{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimukenya.com/schemas/reviews.schema.json",
  "title": "Editorial review decisions (data/reviews.json)",
  "type": "object",
  "required": ["meta", "decisions"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "schema_version", "rule", "updated", "reviewer_roles"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "pattern": "\\S" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "rule": { "type": "string", "pattern": "\\S" },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewer_roles": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z ]+$" } }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["id", "dataset", "record_ids", "source_document_id", "source_sha256", "reviewer_role", "reviewer_is_not_extractor", "decision", "rationale", "date", "supersedes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^REV-\\d{4}-\\d{3,}$" },
        "dataset": { "enum": ["siaya-fiscal-ledger", "siaya-audits", "siaya-health", "siaya-projects", "counties-cob", "history", "siaya-analysis", "siaya-economy", "siaya-governance", "siaya-education", "siaya-agriculture", "siaya-climate", "indicators", "siaya-programmes", "siaya-budget-departments", "siaya-county-series", "siaya-analysis-layers", "imf"] },
        "record_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "source_document_id": { "type": "string", "pattern": "\\S" },
        "source_sha256": { "type": ["string", "null"], "description": "SHA-256 of the document version checked; null only for a rejection, dispute or supersession of a value whose source has no stored copy (an approval always needs it).", "pattern": "^[0-9a-f]{64}$" },
        "pages_checked": { "type": "array", "items": { "type": ["integer", "string"] } },
        "reviewer_role": { "enum": ["fiscal reviewer", "audit reviewer", "health reviewer", "statistics reviewer", "education reviewer", "agriculture reviewer", "climate reviewer", "governance reviewer", "projects reviewer", "geography reviewer", "legal reviewer", "editor"] },
        "reviewer_is_not_extractor": { "enum": [true] },
        "decision": { "enum": ["approved", "rejected", "disputed", "superseded"] },
        "rationale": { "type": "string", "pattern": "\\S{3,}" },
        "conflict_id": { "type": "string", "pattern": "\\S" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^REV-\\d{4}-\\d{3,}$" } }
      }
    }
  }
}
