{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimukenya.com/schemas/ledger-classes.schema.json",
  "title": "Classification of the fiscal ledger's discrepancy cases (data/ledger-classes.json)",
  "type": "object",
  "required": ["meta", "cases"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "rule", "classes", "generated_by", "updated", "counts", "status_counts", "total"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" }, "rule": { "type": "string" }, "generated_by": { "type": "string" },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "classes": { "type": "object", "additionalProperties": { "type": "string" } },
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "status_counts": { "type": "object", "description": "Case statuses copied from data/siaya-fiscal-ledger.json (authoritative); a class is not a status", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "measure", "period", "classification", "reason", "evidence"],
        "additionalProperties": false,
        "properties": {
          "case_id": { "type": "string", "pattern": "^D-L\\d{3}-L\\d{3}$" },
          "measure": { "type": "string" },
          "period": { "type": "string", "pattern": "^FY 20\\d{2}/\\d{2}$" },
          "classification": { "type": "string", "enum": ["definitional", "period or version", "probable source error", "resolved by source", "unexplained"] },
          "reason": { "type": "string", "minLength": 20 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
        }
      }
    }
  }
}
