{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimukenya.com/schemas/county-geography.schema.json",
  "title": "County geographic registry (data/counties/<slug>/geography.json, lib/county-registry.js kind geography)",
  "type": "object",
  "required": ["meta", "sources", "county", "constituencies", "knbs_sub_counties", "wards", "crosswalk", "checks"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "compiled", "county", "iebc_county_code", "official_name_rule", "boundary_vintage", "scope", "lake_rule", "build"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" }, "compiled": { "type": "string" }, "county": { "type": "string" },
        "iebc_county_code": { "type": "string", "pattern": "^\\d{3}$" }, "official_name_rule": { "type": "string" },
        "boundary_vintage": { "type": "string" }, "scope": { "type": "string" }, "lake_rule": { "type": "string" }, "build": { "type": "string" }
      }
    },
    "sources": {
      "type": "array", "minItems": 3,
      "items": { "type": "object", "required": ["id", "used_for"], "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "used_for": { "type": "string" } } }
    },
    "county": {
      "type": "object", "required": ["id", "name", "iebc_county_code", "constitution_first_schedule_number", "constituency_ids"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "iebc_county_code": { "type": "string" }, "constitution_first_schedule_number": { "type": "integer" }, "constituency_ids": { "type": "array", "items": { "type": "string" } } }
    },
    "constituencies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "iebc_constituency_code", "parent", "same_name_knbs_sub_county", "ward_ids", "registered_voters_2022"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "iebc_constituency_code": { "type": "string", "pattern": "^\\d{3}$" }, "parent": { "type": "string" },
          "same_name_knbs_sub_county": { "type": "string" }, "ward_ids": { "type": "array", "items": { "type": "string" } },
          "registered_voters_2022": {
            "type": "object", "required": ["value", "as_printed", "pdf_page", "name_as_printed", "source_id", "unit", "period", "confidence", "read_method"], "additionalProperties": false,
            "properties": { "value": { "type": "integer", "minimum": 1 }, "as_printed": { "type": "string" }, "pdf_page": { "type": "integer", "minimum": 1 }, "name_as_printed": { "type": "string" }, "source_id": { "type": "string" }, "unit": { "type": "string" }, "period": { "type": "string" }, "confidence": { "type": "integer", "minimum": 1, "maximum": 5 }, "read_method": { "type": "string" } }
          }
        }
      }
    },
    "knbs_sub_counties": {
      "type": "array",
      "items": { "type": "object", "required": ["slug", "name", "same_name_constituency_id", "rule"], "additionalProperties": false, "properties": { "slug": { "type": "string" }, "name": { "type": "string" }, "same_name_constituency_id": { "type": ["string", "null"] }, "rule": { "type": "string" } } }
    },
    "wards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "iebc_ward_code", "iebc_constituency_code", "parent", "gazette_pages", "source_names"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "iebc_ward_code": { "type": "string", "pattern": "^\\d{4}$" }, "iebc_constituency_code": { "type": "string", "pattern": "^\\d{3}$" }, "parent": { "type": "string" }, "gazette_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 }, "source_names": { "type": "object" } }
      }
    },
    "crosswalk": {
      "type": "array",
      "items": { "type": "object", "required": ["iebc_code", "iebc_name", "polygon_name", "polygon_sub_county", "rule"], "additionalProperties": false, "properties": { "iebc_code": { "type": "string" }, "iebc_name": { "type": "string" }, "polygon_name": { "type": "string" }, "polygon_sub_county": { "type": "string" }, "rule": { "type": "string" } } }
    },
    "checks": { "type": "object", "required": ["wards", "constituencies", "coverage_valid", "ward_overlap_km2", "ward_area_km2", "official_land_area_km2", "ward_area_vs_official_pct", "constituency_vs_wards", "area_method"] }
  }
}
