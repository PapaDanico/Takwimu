{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/corrections.schema.json",
  "title": "Data corrections log (data/corrections.json)",
  "type": "object",
  "required": ["meta", "entries"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "rule", "baseline", "updated"],
      "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "rule": { "type": "string" }, "baseline": { "type": "string" }, "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dataset", "record_ids", "measure", "original", "corrected", "reason", "evidence", "date", "affected_pages", "was", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^COR-\\d{4}-\\d{3}$" },
          "dataset": { "type": "string" },
          "record_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "measure": { "type": "string" },
          "original": { "type": "string" },
          "corrected": { "type": "string" },
          "reason": { "type": "string", "minLength": 10 },
          "evidence": { "type": "string", "minLength": 5 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "affected_pages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } },
          "was": { "description": "Short original shown in the footnote beside the value: one string, or one per record id", "type": ["string", "object"], "additionalProperties": { "type": "string" } },
          "note": { "type": "string", "minLength": 10, "maxLength": 140, "description": "One-line reason shown in the footnote beside the value" }
        }
      }
    }
  }
}
