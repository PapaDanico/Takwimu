{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/source-library.schema.json",
  "title": "Siaya Source Library (data/source-library.json)",
  "description": "One record per document, following the Document schema of the Siaya research programme (section 6). Rules the checker cannot express in this subset are enforced in scripts/validate-data.js: unique IDs and addresses, sha256 and bytes present if and only if retrieval_status is downloaded, redistribution_allowed false when the licence is not stated, parent_id must name a record.",
  "type": "object",
  "required": ["meta", "documents"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "note", "method", "updated", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "note": { "type": "string" },
        "method": { "type": "string" },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "schema_version": { "type": "string" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "document": {
      "type": "object",
      "required": ["document_id", "title", "publisher", "document_type", "publication_date", "reference_period", "source_url", "sha256", "bytes", "licence", "redistribution_allowed", "geographic_coverage", "siaya_relevance", "research_use", "retrieval_status", "retrieval_note", "review_status", "last_checked_at", "origin"],
      "additionalProperties": false,
      "properties": {
        "document_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
        "origin": { "type": "string", "enum": ["programme register", "linked from a programme source", "cited by the site"] },
        "parent_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "document_type": { "type": "string" },
        "publication_date": { "type": "string", "pattern": "^(\\d{4}(-\\d{2}(-\\d{2})?)?|not stated)$" },
        "reference_period": { "type": "string" },
        "source_url": { "$ref": "#/$defs/url" },
        "file_url": { "$ref": "#/$defs/url" },
        "also_at": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/url" } },
        "cited_by": { "type": "string" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": ["integer", "null"], "minimum": 1 },
        "file_type": { "type": "string", "enum": ["PDF", "HTML", "CSV", "XLSX", "JSON"] },
        "licence": { "type": "string" },
        "redistribution_allowed": { "type": "boolean" },
        "redistribution_conditions": { "type": "string" },
        "geographic_coverage": { "type": "string", "enum": ["Siaya", "multi-county including Siaya", "national"] },
        "siaya_relevance": { "type": "string" },
        "research_use": { "type": "string" },
        "retrieval_status": { "type": "string", "enum": ["downloaded", "discovered", "inaccessible", "blocked"] },
        "retrieval_note": { "type": "string" },
        "review_status": { "type": "string", "enum": ["not reviewed", "figures in use, not specialist-reviewed", "reviewed"] },
        "last_checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
