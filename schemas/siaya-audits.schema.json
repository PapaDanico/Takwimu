{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-audits.schema.json",
  "title": "Siaya Auditor-General findings tracker (data/siaya-audits.json)",
  "type": "object",
  "required": [
    "meta",
    "documents",
    "opinions",
    "findings",
    "same_items",
    "recurrence_by_category",
    "gaps",
    "caveats"
  ],
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "string",
      "enum": [
        "county_executive",
        "county_assembly",
        "county_government"
      ]
    },
    "fy": {
      "type": "string",
      "pattern": "^20[0-9]{2}/[0-9]{2}$"
    },
    "amount": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "KSh"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 2
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "schema_version",
        "extracted",
        "rule",
        "entities",
        "recurrence_rule",
        "amounts_rule",
        "pages",
        "method"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "entity",
          "fy",
          "period",
          "title",
          "issuer",
          "report_date",
          "date_note",
          "date_page",
          "url",
          "bytes",
          "sha256",
          "md5_library",
          "text_source",
          "confidence",
          "in_manifest",
          "retrieved",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "type": "string",
            "pattern": "^audit-[a-z0-9-]+$"
          },
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "report_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "date_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "md5_library": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{32}$"
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "in_manifest": {
            "type": "boolean"
          },
          "period": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "date_note": {
            "type": "string"
          },
          "text_source": {
            "type": "string"
          },
          "retrieved": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "opinions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity",
          "fy",
          "opinion",
          "opinion_note",
          "doc_id",
          "page",
          "confidence",
          "history"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "opinion": {
            "type": [
              "string",
              "null"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "history": {
            "type": "string",
            "enum": [
              "matches",
              "not in history"
            ]
          },
          "opinion_note": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "entity",
          "fy",
          "doc_id",
          "page",
          "paragraph",
          "section",
          "title",
          "category",
          "amounts",
          "unresolved_prior_year",
          "listed_unresolved_next_year",
          "same_item",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^audit-[a-z0-9-]+-[0-9]{2}$"
          },
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "doc_id": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "paragraph": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "enum": [
              "financial_statements",
              "basis_for_disclaimer",
              "emphasis_of_matter",
              "other_matter",
              "lawfulness",
              "internal_controls",
              "financial_operations"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "category": {
            "type": "string",
            "enum": [
              "pending_bills",
              "revenue",
              "assets",
              "procurement",
              "payroll",
              "budget_control",
              "ict",
              "projects",
              "unsupported_expenditure",
              "financial_reporting",
              "cash_and_bank",
              "imprest",
              "transfers",
              "governance",
              "other"
            ]
          },
          "amounts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/amount"
            }
          },
          "unresolved_prior_year": {
            "type": "object",
            "required": [
              "flag",
              "basis"
            ],
            "additionalProperties": false,
            "properties": {
              "flag": {
                "type": "boolean"
              },
              "basis": {
                "type": "string"
              }
            }
          },
          "listed_unresolved_next_year": {
            "type": "boolean"
          },
          "same_item": {
            "type": [
              "string",
              "null"
            ]
          },
          "report_heading": {
            "type": "object",
            "required": [
              "text",
              "quoted"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "quoted": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "same_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "entity",
          "basis",
          "finding_ids",
          "years"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "finding_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "years": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/fy"
            }
          },
          "key": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        }
      }
    },
    "recurrence_by_category": {
      "type": "object"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity",
          "fy",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "status": {
            "type": "string",
            "enum": [
              "missing",
              "opinion only"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
