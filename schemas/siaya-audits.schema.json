{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-audits.schema.json",
  "title": "County Auditor-General opinions and findings tracker (Siaya: data/siaya-audits.json; other counties: data/counties/<slug>/audits.json, see lib/county-registry.js)",
  "type": "object",
  "required": [
    "meta",
    "documents",
    "opinions",
    "findings",
    "same_items",
    "recurrence_by_category",
    "gaps",
    "caveats"
  ],
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "string",
      "enum": [
        "county_executive",
        "county_assembly",
        "county_government",
        "county_revenue_fund",
        "receiver_of_revenue",
        "water_company"
      ],
      "description": "Separately audited entities are never merged into the county: county_revenue_fund (County Revenue Fund statements), receiver_of_revenue (Receiver of Revenue statements of own-source revenue), water_company (a county-owned water and sanitation company)."
    },
    "fy": {
      "type": "string",
      "pattern": "^20[0-9]{2}/[0-9]{2}$"
    },
    "amount": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "KSh"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 2
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "schema_version",
        "extracted",
        "rule",
        "entities",
        "recurrence_rule",
        "amounts_rule",
        "pages",
        "method"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "entity",
          "fy",
          "period",
          "title",
          "issuer",
          "report_date",
          "date_note",
          "date_page",
          "url",
          "bytes",
          "sha256",
          "md5_library",
          "text_source",
          "confidence",
          "in_manifest",
          "retrieved",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "doc_id": {
            "type": "string",
            "pattern": "^audit-[a-z0-9-]+$"
          },
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "report_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "date_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "md5_library": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{32}$"
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "in_manifest": {
            "type": "boolean"
          },
          "period": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "date_note": {
            "type": "string"
          },
          "text_source": {
            "type": "string"
          },
          "retrieved": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "opinions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity",
          "fy",
          "opinion",
          "opinion_note",
          "doc_id",
          "page",
          "confidence",
          "history"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "opinion": {
            "type": [
              "string",
              "null"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "history": {
            "type": "string",
            "enum": [
              "matches",
              "not in history"
            ]
          },
          "opinion_note": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "source_type": { "type": "string", "enum": ["primary", "official mirror", "official compilation (secondary)", "secondary-news/ngo"], "description": "Kind of document the value was read from: primary (the publisher's own report), official mirror (an official body reprinting or quoting it), official compilation (secondary: an official body's summary table of other reports), secondary-news/ngo (media or civil society). Added 27 Nov 2026 (gap research ingest)." },
          "corroboration": { "type": "array", "description": "Other documents that print the same opinion for the same entity and year (corroboration, not a second opinion).", "items": { "type": "object", "required": ["document", "url", "sha256", "page", "quote", "source_type"], "additionalProperties": false, "properties": { "document": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "page": { "type": "integer", "minimum": 1 }, "quote": { "type": "string", "minLength": 5 }, "source_type": { "type": "string", "enum": ["primary", "official mirror", "official compilation (secondary)", "secondary-news/ngo"], "description": "Kind of document the value was read from: primary (the publisher's own report), official mirror (an official body reprinting or quoting it), official compilation (secondary: an official body's summary table of other reports), secondary-news/ngo (media or civil society). Added 27 Nov 2026 (gap research ingest)." } } } },
          "tier": {
            "type": "string",
            "enum": ["primary", "secondary"],
            "description": "primary: the Auditor-General's own report; secondary: a summary by another body (e.g. a civil-society simplified version), shown with that tier and never as the audit itself."
          },
          "quote": {
            "type": "string",
            "description": "The opinion sentence as read (first words), for the reviewer."
          },
          "quote_page": {
            "type": "integer",
            "minimum": 1,
            "description": "PDF page of the quoted opinion sentence when it is not on the heading page."
          },
          "read_method": {
            "type": "string",
            "enum": ["text", "ocr-tesseract"]
          },
          "second_reading": {
            "type": "object",
            "required": ["method", "agrees", "note"],
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string" },
              "agrees": { "type": "boolean" },
              "note": { "type": "string" }
            }
          },
          "needs_page_check": {
            "type": "boolean",
            "enum": [true],
            "description": "Read by OCR (or from a garbled text layer): a person must confirm the opinion against the page image."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "description": "At least one finding for Siaya (scripts/test-audits.js); a county may hold opinions only while its findings are not yet coded.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "entity",
          "fy",
          "doc_id",
          "page",
          "paragraph",
          "section",
          "title",
          "category",
          "amounts",
          "unresolved_prior_year",
          "listed_unresolved_next_year",
          "same_item",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^audit-[a-z0-9-]+-[0-9]{2}$"
          },
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "doc_id": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "paragraph": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "enum": [
              "financial_statements",
              "basis_for_disclaimer",
              "emphasis_of_matter",
              "other_matter",
              "lawfulness",
              "internal_controls",
              "financial_operations"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "category": {
            "type": "string",
            "enum": [
              "pending_bills",
              "revenue",
              "assets",
              "procurement",
              "payroll",
              "budget_control",
              "ict",
              "projects",
              "unsupported_expenditure",
              "financial_reporting",
              "cash_and_bank",
              "imprest",
              "transfers",
              "governance",
              "other"
            ]
          },
          "amounts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/amount"
            }
          },
          "unresolved_prior_year": {
            "type": "object",
            "required": [
              "flag",
              "basis"
            ],
            "additionalProperties": false,
            "properties": {
              "flag": {
                "type": "boolean"
              },
              "basis": {
                "type": "string"
              }
            }
          },
          "listed_unresolved_next_year": {
            "type": "boolean"
          },
          "same_item": {
            "type": [
              "string",
              "null"
            ]
          },
          "report_heading": {
            "type": "object",
            "required": [
              "text",
              "quoted"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "quoted": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "same_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "entity",
          "basis",
          "finding_ids",
          "years"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "finding_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "years": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/fy"
            }
          },
          "key": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        }
      }
    },
    "recurrence_by_category": {
      "type": "object"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity",
          "fy",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "entity": {
            "$ref": "#/$defs/entity"
          },
          "fy": {
            "$ref": "#/$defs/fy"
          },
          "status": {
            "type": "string",
            "enum": [
              "missing",
              "opinion only"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
