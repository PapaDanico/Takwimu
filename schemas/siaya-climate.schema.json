{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-climate.schema.json",
  "title": "Siaya climate, water and resilience evidence by source (data/siaya-climate.json)",
  "type": "object",
  "required": ["meta", "ward_register", "sources", "observations", "comparisons", "gaps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "county", "county_code", "retrieved", "schema_version", "rule", "confidence_scale", "definitions"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "county": { "enum": ["Siaya"] },
        "county_code": { "type": "integer" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "schema_version": { "type": "string" },
        "rule": { "type": "string" },
        "confidence_scale": { "type": "object", "additionalProperties": { "type": "string" } },
        "definitions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "ward_register": {
      "type": "object",
      "required": ["source_id", "pdf_page", "printed_page", "note", "wards"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string" },
        "pdf_page": { "type": "integer", "minimum": 1 },
        "printed_page": { "type": ["integer", "null"] },
        "note": { "type": "string" },
        "wards": {
          "type": "array",
          "minItems": 30,
          "items": {
            "type": "object",
            "required": ["sub_county", "name", "as_printed"],
            "additionalProperties": false,
            "properties": {
              "sub_county": { "enum": ["Alego Usonga", "Gem", "Ugenya", "Ugunja", "Bondo", "Rarieda"] },
              "name": { "type": "string" },
              "as_printed": { "type": "string" }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "library_dir", "title", "publisher", "publication_date", "reference_period", "url", "register_url", "file_type", "sha256", "bytes", "pdf_pages", "page_rule", "licence", "access_status", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "library_dir": { "type": "string" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "publication_date": { "type": "string" },
          "reference_period": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "register_url": { "type": ["string", "null"] },
          "file_type": { "enum": ["PDF"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "pdf_pages": { "type": "integer", "minimum": 1 },
          "page_rule": { "type": "string" },
          "licence": { "type": "string" },
          "access_status": { "enum": ["downloaded"] },
          "note": { "type": "string" }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "series", "measure", "value", "value_text", "unit", "period", "geography", "sub_county", "area_as_printed", "ward_register_name", "spelling_note", "hazard", "hotspots_as_printed", "rank_as_printed", "source_id", "pdf_page", "printed_page", "table", "quote", "definition", "confidence", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "enum": ["allocation", "receipt", "transfer", "expenditure", "outcome", "hazard ranking", "coverage"] },
          "series": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "measure": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "value_text": { "type": ["string", "null"] },
          "unit": { "type": ["string", "null"] },
          "period": { "type": "string" },
          "geography": { "enum": ["county", "sub-county", "ward", "utility service area"] },
          "sub_county": { "type": ["string", "null"] },
          "area_as_printed": { "type": "string" },
          "ward_register_name": { "type": ["string", "null"] },
          "spelling_note": { "type": ["string", "null"] },
          "hazard": { "type": ["string", "null"] },
          "hotspots_as_printed": { "type": ["string", "null"] },
          "rank_as_printed": { "type": ["string", "null"] },
          "source_id": { "type": "string" },
          "pdf_page": { "type": "integer", "minimum": 1 },
          "printed_page": { "type": ["integer", "null"] },
          "table": { "type": "string" },
          "quote": { "type": "string" },
          "definition": { "type": "string" },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "observation_ids", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "topic": { "type": "string" },
          "observation_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "reason"],
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
