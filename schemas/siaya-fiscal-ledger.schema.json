{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/siaya-fiscal-ledger.schema.json",
  "title": "Siaya fiscal reconciliation ledger (data/siaya-fiscal-ledger.json)",
  "type": "object",
  "required": ["meta", "measures", "years", "sources", "observations", "discrepancies", "completeness"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "county", "county_code", "retrieved", "schema_version", "rule", "discrepancy_rule", "threshold_pct", "programme", "read_methods", "confidence_scale", "not_used"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "county": { "type": "string", "enum": ["Siaya"] },
        "county_code": { "type": "integer", "enum": [41] },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "schema_version": { "type": "string" },
        "rule": { "type": "string" },
        "discrepancy_rule": { "type": "string" },
        "threshold_pct": { "type": "number", "exclusiveMinimum": 0 },
        "programme": { "type": "string" },
        "read_methods": { "type": "object", "additionalProperties": { "type": "string" } },
        "confidence_scale": { "type": "string" },
        "not_used": { "type": "array", "items": { "type": "string" } }
      }
    },
    "measures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "unit", "definition"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "unit": { "type": "string", "enum": ["KSh million"] },
          "definition": { "type": "string" }
        }
      }
    },
    "years": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^20\\d{2}/\\d{2}$" } },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "publisher", "kind", "publication_date", "url", "sha256"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "kind": { "type": "string", "enum": ["county", "controller_of_budget", "auditor_general", "senate_quoting_auditor_general", "other"] },
          "publication_date": { "type": "string" },
          "reference_period": { "type": ["string", "null"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "licence": { "type": ["string", "null"] }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "measure", "fy", "value", "unit", "source_id", "source_kind", "table", "pdf_page", "printed_page", "read_method", "original_text", "confidence", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^L\\d{3}$" },
          "as_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Pending bills: the date of the stock as the document states it (30 June closing, or 1 July opening of the next year)." },
          "accounting_basis": { "type": "string", "enum": ["cash", "accrual", "eligible-verified", "as reported"], "description": "Pending bills: the accounting basis of the stock. \"as reported\" when the document gives the county's figure without a cash, accrual or eligibility-verification basis." },
          "source_error": { "type": "object", "description": "An error in the source document itself (impossible date, figures that do not agree). The value stays as published.", "required": ["quote", "page", "issue"], "additionalProperties": false, "properties": { "quote": { "type": "string", "minLength": 3 }, "page": { "type": "integer", "minimum": 1 }, "printed_page": { "type": ["integer", "null"] }, "issue": { "type": "string", "minLength": 10 } } },
          "measure": { "type": "string" },
          "fy": { "type": "string", "pattern": "^20\\d{2}/\\d{2}$" },
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string", "enum": ["KSh million", "KSh billion"] },
          "budget_version": { "type": "string", "enum": ["original", "supplementary", "not stated"] },
          "stock_point": { "type": "string", "enum": ["closing", "opening_of_next_year"] },
          "scope": { "type": "string" },
          "basis": { "type": "string" },
          "source_id": { "type": "string" },
          "source_kind": { "type": "string", "enum": ["county", "controller_of_budget", "auditor_general", "senate_quoting_auditor_general", "other"] },
          "table": { "type": ["string", "null"] },
          "pdf_page": { "type": "integer", "minimum": 1 },
          "printed_page": { "type": ["integer", "null"], "minimum": 1 },
          "read_method": { "type": "string", "enum": ["text", "ocr-tesseract", "ocr-rapidocr"] },
          "original_text": { "type": ["string", "null"] },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "reused_from": {
            "type": "object",
            "required": ["file", "path"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "enum": ["data/history.json", "data/counties-cob.json"] },
              "path": { "type": "array", "minItems": 1 }
            }
          },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "indicator_id", "period", "claim_a", "claim_b", "source_a", "source_b", "difference", "possible_basis_mismatch", "status", "resolution", "reviewer", "reviewed_at"],
        "additionalProperties": false,
        "properties": {
          "case_id": { "type": "string", "pattern": "^D-L\\d{3}-L\\d{3}$" },
          "indicator_id": { "type": "string" },
          "period": { "type": "string", "pattern": "^FY 20\\d{2}/\\d{2}$" },
          "claim_a": { "$ref": "#/$defs/claim" },
          "claim_b": { "$ref": "#/$defs/claim" },
          "source_a": { "$ref": "#/$defs/source_ref" },
          "source_b": { "$ref": "#/$defs/source_ref" },
          "difference": {
            "type": "object",
            "required": ["absolute_ksh_m", "pct_of_smaller", "b_minus_a_ksh_m"],
            "additionalProperties": false,
            "properties": {
              "absolute_ksh_m": { "type": "number", "exclusiveMinimum": 0 },
              "pct_of_smaller": { "type": "number", "exclusiveMinimum": 0 },
              "b_minus_a_ksh_m": { "type": "number" }
            }
          },
          "possible_basis_mismatch": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["open"] },
          "resolution": { "type": "null" },
          "reviewer": { "type": "null" },
          "reviewed_at": { "type": "null" }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["n_values", "n_sources", "source_kinds", "missing"],
          "additionalProperties": false,
          "properties": {
            "n_values": { "type": "integer", "minimum": 0 },
            "n_sources": { "type": "integer", "minimum": 0 },
            "source_kinds": { "type": "array", "items": { "type": "string" } },
            "missing": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["observation_id", "value_ksh_m", "printed"],
      "additionalProperties": false,
      "properties": {
        "observation_id": { "type": "string", "pattern": "^L\\d{3}$" },
        "value_ksh_m": { "type": "number" },
        "printed": { "type": ["string", "null"] }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["source_id", "pdf_page"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string" },
        "pdf_page": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
