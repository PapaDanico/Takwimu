{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimukenya.com/schemas/national.schema.json",
  "title": "Kenya national indicators, World Bank WDI (data/national.json)",
  "type": "object",
  "required": ["meta", "indicators"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "country", "iso3", "period", "retrieved", "source_id", "schema_version", "rule", "gaps"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "country": { "type": "string", "enum": ["Kenya"] },
        "iso3": { "type": "string", "enum": ["KEN"] },
        "period": { "type": "string" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source_id": { "type": "string" },
        "schema_version": { "type": "string" },
        "rule": { "type": "string" },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "unit", "sector", "source", "original_source", "api_url", "last_updated", "retrieved", "source_note", "modelled_or_estimated_note", "years_with_values", "missing_years", "series", "source_id"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9.]+$" },
          "name": { "type": "string" },
          "unit": { "type": "string" },
          "sector": { "type": "string", "enum": ["economy", "money and banking", "people", "health", "education", "infrastructure", "environment", "public finance"] },
          "source": { "type": "string", "enum": ["World Bank, World Development Indicators"] },
          "original_source": { "type": "string" },
          "api_url": { "type": "string", "pattern": "^https://api\\.worldbank\\.org/v2/country/KEN/indicator/" },
          "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "source_note": { "type": "string" },
          "modelled_or_estimated_note": { "type": ["string", "null"] },
          "years_with_values": { "type": ["array", "null"], "items": { "type": "integer" } },
          "missing_years": { "type": "array", "items": { "type": "integer" } },
          "source_id": { "type": "string" },
          "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "series": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["year", "value"],
              "additionalProperties": false,
              "properties": { "year": { "type": "integer", "minimum": 2010, "maximum": 2030 }, "value": { "type": ["number", "null"] } }
            }
          }
        }
      }
    }
  }
}
