{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takwimu.netlify.app/schemas/catalogue.schema.json",
  "title": "Dataset catalogue entries (lib/explore.js catalogue(), built to data/datasets/catalogue.json)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "description", "sector", "geography", "area", "period", "years", "source", "source_detail", "source_url", "unit", "coverage", "method", "last_updated", "retrieved", "views", "files", "data_file", "version", "download_name", "status", "status_reason"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "source_url": { "type": "string", "pattern": "^https://" },
      "years": { "type": "array", "items": { "type": "integer" } },
      "files": { "type": "object", "required": ["csv", "json"], "properties": { "csv": { "type": "string", "pattern": "^/data/.+\\.csv$" }, "json": { "type": "string", "pattern": "^/data/.+\\.json$" } } },
      "data_file": { "type": "string", "pattern": "^data/[a-z0-9-]+\\.json$" },
      "version": { "type": "string", "pattern": "^[0-9a-f]{10}$" },
      "download_name": { "type": "string", "pattern": "^[a-z0-9-]+-[0-9a-f]{10}$" },
      "status": { "enum": ["verified", "provisional", "estimated", "disputed", "unavailable", "superseded"] },
      "status_reason": { "type": "string", "pattern": "\\S" },
      "superseded_by": { "type": "string" },
      "review": {
        "type": "object",
        "required": ["approved", "pending", "rejected", "disputed", "superseded", "total"],
        "additionalProperties": false,
        "properties": {
          "approved": { "type": "integer", "minimum": 0 }, "pending": { "type": "integer", "minimum": 0 }, "rejected": { "type": "integer", "minimum": 0 },
          "disputed": { "type": "integer", "minimum": 0 }, "superseded": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
